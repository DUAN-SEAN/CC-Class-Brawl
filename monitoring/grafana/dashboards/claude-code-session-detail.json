    {
      "title": "Event Log",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 41 },
      "id": 204,
      "collapsed": false,
      "panels": []
    },
    {
      "title": "Event Log",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 42 },
      "id": 60,
      "type": "logs",
      "datasource": { "uid": "loki" },
      "targets": [
        {
          "expr": "{service_name=\"claude-code\"} | session_id=\"$session_id\" | label_format display=event_name | line_format \"{{.display}}\"",
          "refId": "A"
        }
      ],
      "options": { "showLabels": true, "showTime": true, "sortOrder": "Descending", "dedupStrategy": "none", "enableLogDetails": true }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["claude-code", "session-detail"],
  "templating": {
    "list": [
      {
        "name": "session_id",
        "type": "query",
        "label": "Session ID",
        "datasource": { "uid": "prometheus" },
        "refresh": 2,
        "query": "label_values(claude_code_cost_usage_USD_total, session_id)",
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Claude Code Session Detail",
  "uid": "claude-code-session",
  "version": 4
}
