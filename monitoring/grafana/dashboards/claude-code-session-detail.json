        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "^(Time|line|detected_level|service_name|session_id|event_name|event_sequence|observed_timestamp|terminal_type|os_type|os_version|host_arch|environment|scope_name|scope_version|service_version|user_id|prompt_id|is_built_in|is_async)$" }, "properties": [{ "id": "custom.hidden", "value": true }] },
          { "matcher": { "id": "byName", "options": "event_timestamp" }, "properties": [{ "id": "displayName", "value": "Time" }] },
          { "matcher": { "id": "byName", "options": "agent_type" }, "properties": [{ "id": "displayName", "value": "Agent" }] },
          { "matcher": { "id": "byName", "options": "agent_source" }, "properties": [{ "id": "displayName", "value": "From" }] },
          { "matcher": { "id": "byName", "options": "model" }, "properties": [{ "id": "displayName", "value": "Model" }] },
          { "matcher": { "id": "byName", "options": "total_tokens" }, "properties": [{ "id": "displayName", "value": "Tokens" }] },
          { "matcher": { "id": "byName", "options": "total_tool_uses" }, "properties": [{ "id": "displayName", "value": "Tools" }] },
          { "matcher": { "id": "byName", "options": "duration_ms" }, "properties": [{ "id": "displayName", "value": "Duration" }, { "id": "unit", "value": "ms" }] }
        ]
      },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "Time", "desc": true }] }
    },
    {
      "title": "Tools",
