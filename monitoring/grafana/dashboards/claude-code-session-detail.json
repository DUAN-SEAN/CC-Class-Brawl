        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "^(Time|line|detected_level|service_name|session_id|event_name|event_sequence|observed_timestamp|terminal_type|os_type|os_version|host_arch|environment|scope_name|scope_version|service_version|user_id|prompt_id|tool_use_id|tool_input_size_bytes|tool_result_size_bytes)$" }, "properties": [{ "id": "custom.hidden", "value": true }] },
          { "matcher": { "id": "byName", "options": "event_timestamp" }, "properties": [{ "id": "displayName", "value": "Time" }] },
          { "matcher": { "id": "byName", "options": "tool_name" }, "properties": [{ "id": "displayName", "value": "Tool" }] },
          { "matcher": { "id": "byName", "options": "success" }, "properties": [{ "id": "displayName", "value": "OK" }] },
          { "matcher": { "id": "byName", "options": "duration_ms" }, "properties": [{ "id": "displayName", "value": "Duration" }, { "id": "unit", "value": "ms" }] }
        ]
      },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "Time", "desc": true }] }
