    {
      "title": "Hooks & Errors",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 },
      "id": 203,
      "collapsed": false,
      "panels": []
    },
    {
      "title": "Hooks",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 35 },
      "id": 30,
      "type": "table",
      "datasource": { "uid": "loki" },
      "targets": [
        {
          "expr": "{service_name=\"claude-code\"} | session_id=\"$session_id\" | event_name=\"hook_execution_complete\"",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "^(Time|line|detected_level|service_name|session_id|event_name|event_sequence|observed_timestamp|terminal_type|os_type|os_version|host_arch|environment|scope_name|scope_version|service_version|user_id|prompt_id|managed_only|hook_source|num_hooks)$" }, "properties": [{ "id": "custom.hidden", "value": true }] },
          { "matcher": { "id": "byName", "options": "event_timestamp" }, "properties": [{ "id": "displayName", "value": "Time" }] },
          { "matcher": { "id": "byName", "options": "hook_event" }, "properties": [{ "id": "displayName", "value": "Trigger" }] },
