    {
      "title": "Errors",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 35 },
      "id": 55,
      "type": "table",
      "datasource": { "uid": "loki" },
      "targets": [
        {
          "expr": "{service_name=\"claude-code\"} | session_id=\"$session_id\" | event_name=~\"api_error|internal_error\"",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "^(Time|line|detected_level|service_name|session_id|event_sequence|observed_timestamp|terminal_type|os_type|os_version|host_arch|environment|scope_name|scope_version|service_version|user_id|prompt_id)$" }, "properties": [{ "id": "custom.hidden", "value": true }] },
          { "matcher": { "id": "byName", "options": "event_timestamp" }, "properties": [{ "id": "displayName", "value": "Time" }] },
          { "matcher": { "id": "byName", "options": "event_name" }, "properties": [{ "id": "displayName", "value": "Type" }] },
          { "matcher": { "id": "byName", "options": "model" }, "properties": [{ "id": "displayName", "value": "Model" }] },
          { "matcher": { "id": "byName", "options": "status_code" }, "properties": [{ "id": "displayName", "value": "Status" }] },
          { "matcher": { "id": "byName", "options": "error" }, "properties": [{ "id": "displayName", "value": "Error" }] },
          { "matcher": { "id": "byName", "options": "error_name" }, "properties": [{ "id": "displayName", "value": "Code" }] }
        ]
      },
