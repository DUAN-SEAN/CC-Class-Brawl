          { "matcher": { "id": "byName", "options": "num_cancelled" }, "properties": [{ "id": "displayName", "value": "Cancelled" }] },
          { "matcher": { "id": "byName", "options": "total_duration_ms" }, "properties": [{ "id": "displayName", "value": "Duration" }, { "id": "unit", "value": "ms" }] }
