{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Session Detail",
      "url": "/d/claude-code-session?orgId=1&var-session_id=${__var_session_id}",
      "type": "dashboard"
    }
  ],
  "panels": [
    {
      "title": "Summary",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "collapsed": false,
      "panels": []
    },
    {
      "title": "Sessions (1h)",
      "description": "Number of Claude Code sessions started in the last hour",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "type": "stat",
      "datasource": { "uid": "prometheus" },
      "targets": [
        { "expr": "sum(increase(claude_code_session_count_total[1h]))", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          },
          "unit": "none"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "title": "Cost (1h)",
      "description": "Total cost in USD over the last hour",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "type": "stat",
      "datasource": { "uid": "prometheus" },
      "targets": [
        { "expr": "sum(increase(claude_code_cost_usage_USD_total[1h]))", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "currencyUSD",
          "decimals": 2
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "title": "Tokens (1h)",
      "description": "Total tokens consumed in the last hour",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "type": "stat",
      "datasource": { "uid": "prometheus" },
      "targets": [
        { "expr": "sum(increase(claude_code_token_usage_tokens_total[1h]))", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "blue", "value": null },
              { "color": "yellow", "value": 500000 },
              { "color": "red", "value": 1000000 }
            ]
          },
          "unit": "short"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "title": "Lines of Code (1h)",
      "description": "Lines of code changed in the last hour",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "type": "stat",
      "datasource": { "uid": "prometheus" },
      "targets": [
        { "expr": "sum(increase(claude_code_lines_of_code_count_total[1h]))", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 500 },
              { "color": "red", "value": 2000 }
            ]
          },
          "unit": "none"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },

    {
      "title": "Trends",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "collapsed": false,
      "panels": []
    },
    {
      "title": "Cost Over Time by Model",
      "description": "Hourly cost breakdown by model",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 6 },
      "id": 5,
      "type": "timeseries",
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (model) (increase(claude_code_cost_usage_USD_total[$__rate_interval]))",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 30, "showPoints": "auto" },
          "unit": "currencyUSD"
        }
      }
    },
    {
      "title": "Token Usage by Type",
      "description": "Token consumption breakdown by input/output/cache type",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 6 },
      "id": 6,
      "type": "timeseries",
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (type) (increase(claude_code_token_usage_tokens_total[$__rate_interval]))",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 30, "showPoints": "auto" },
          "unit": "short"
        }
      }
    },
    {
      "title": "Active Development Time",
      "description": "Cumulative active development time",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 6 },
      "id": 7,
      "type": "timeseries",
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(claude_code_active_time_seconds_total[$__rate_interval]))",
          "legendFormat": "Active Time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 30, "showPoints": "auto" },
          "unit": "s"
        }
      }
    },

    {
      "title": "Productivity",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "collapsed": false,
      "panels": []
    },
    {
      "title": "Code Edit Decisions",
      "description": "Code edit tool decisions over time (accept, reject, modify)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 15 },
      "id": 8,
      "type": "timeseries",
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (decision) (increase(claude_code_code_edit_tool_decision_total[$__rate_interval]))",
          "legendFormat": "{{decision}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 30, "showPoints": "auto" },
          "unit": "short"
        }
      }
    },
    {
      "title": "Session Rate by Model",
      "description": "Session start rate per model over time",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 15 },
      "id": 11,
      "type": "timeseries",
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (model) (rate(claude_code_session_count_total[$__rate_interval]))",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 20, "showPoints": "auto" },
          "unit": "ops"
        }
      }
    },
    {
      "title": "Commits & PRs (1h)",
      "description": "Commit and pull request count in the last hour",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "id": 10,
      "type": "barchart",
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(claude_code_commit_count_total[1h]))",
          "legendFormat": "Commits",
          "refId": "A"
        },
        {
          "expr": "sum(increase(claude_code_pull_request_count_total[1h]))",
          "legendFormat": "Pull Requests",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "none"
        }
      },
      "options": {
        "xTickLabelRotation": 0,
        "groupWidth": 0.7,
        "barWidth": 0.5,
        "stacking": "none"
      }
    },

    {
      "title": "Distribution",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 103,
      "collapsed": false,
      "panels": []
    },
    {
      "title": "Cost by Model (Pie)",
      "description": "Cost distribution across models",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "id": 9,
      "type": "piechart",
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (model) (increase(claude_code_cost_usage_USD_total[1h]))",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "pieType": "donut",
        "displayLabels": ["name", "percent"]
      }
    },
    {
      "title": "Token Distribution by Type (Pie)",
      "description": "Token usage split by input/output/cache_read/cache_creation",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "id": 12,
      "type": "piechart",
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (type) (increase(claude_code_token_usage_tokens_total[1h]))",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "pieType": "donut",
        "displayLabels": ["name", "percent"]
      }
    },
    {
      "title": "Cost by Model (Table)",
      "description": "Cost breakdown by model in tabular form",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "id": 14,
      "type": "table",
      "datasource": { "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (model) (increase(claude_code_cost_usage_USD_total[1h]))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Time" },
            "properties": [{ "id": "custom.hidden", "value": true }]
          },
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [{ "id": "displayName", "value": "Cost (USD)" }]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": { "show": true, "reducer": ["sum"] }
      }
    },

    {
      "title": "Events",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "id": 104,
      "collapsed": false,
      "panels": []
    },
    {
      "title": "Recent Events",
      "description": "Latest Claude Code telemetry events from logs",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 33 },
      "id": 13,
      "type": "logs",
      "datasource": { "uid": "loki" },
      "targets": [
        {
          "expr": "{service_name=\"claude-code\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["claude-code", "observability"],
  "templating": {
    "list": [
      {
        "name": "session_id",
        "type": "query",
        "datasource": { "uid": "prometheus" },
        "refresh": 2,
        "query": "label_values(claude_code_session_count_total, session_id)",
        "sort": 1,
        "multi": false,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "model",
        "type": "query",
        "datasource": { "uid": "prometheus" },
        "refresh": 2,
        "query": "label_values(claude_code_session_count_total, model)",
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Claude Code Observability",
  "uid": "claude-code-obs",
  "version": 3
}
