/* ============================================================
 * USS HUD Animation — Keyframes, pulse, flash, fade
 * Source: design/ux/hud-visual-design.md section 4.8, section 5
 * ============================================================ */

/* ---- KO Sequence ---- */
/* Phase 1: Scale 0 -> 1.5x (0.3s EaseOutBack)              */
/* Phase 2: Hold 1.0x (0.5s)                                 */
/* Phase 3: Fade out opacity 1->0 (0.3s cubic ease-out)      */
/* Total: ~1.1s. Managed by HUDAnimator in C# via scheduled   */
/* callbacks because UI Toolkit USS does not support chained   */
/* keyframe sequences natively. The classes below provide the  */
/* visual states the C# code toggles between.                  */

.ko-notification.phase-enter {
    display: DisplayStyle.Flex;
    opacity: 1;
    scale: 1.5;
}

.ko-notification.phase-hold {
    display: DisplayStyle.Flex;
    opacity: 1;
    scale: 1.0;
}

.ko-notification.phase-fade {
    display: DisplayStyle.Flex;
    opacity: 0;
    scale: 1.0;
    transition: opacity 300ms cubic-bezier(0.55, 0.085, 0.68, 0.53);
}

.ko-notification.hidden {
    display: none;
    opacity: 0;
    scale: 0;
}

/* ---- HUD Root Fade ---- */
.hud-root {
    transition: opacity var(--anim-hud-fade) cubic-bezier(0.33, 1, 0.68, 1);
}

.hud-root.fade-in {
    opacity: 1;
}

.hud-root.fade-out {
    opacity: 0;
    transition: opacity var(--anim-hud-fade) cubic-bezier(0.55, 0.085, 0.68, 0.53);
}

/* ---- Focus Pulse States ---- */
/* Pulse is driven by C# schedule loop (sine wave opacity modulation). */
/* The .pulse class marks the element as pulsing; C# modulates opacity. */

.focus-fill.pulse-fast {
    /* Marker class for 3Hz pulse rate — actual modulation in C# */
}

/* ---- Skill Slot Equip Sequence ---- */
/* Phase 1: Scale 0 -> 1.2x linear 0.05s */
/* Phase 2: Scale 1.2x -> 1.0x cubic ease-out 0.2s */

.skill-slot.equip-phase1 .skill-icon {
    scale: 1.2;
    transition: scale 50ms linear;
}

.skill-slot.equip-phase2 .skill-icon {
    scale: 1.0;
    transition: scale 200ms cubic-bezier(0.33, 1, 0.68, 1);
}

/* ---- Interrupt Flash ---- */
.skill-slot.flash-interrupt {
    border-color: var(--color-interrupt-flash);
    transition: border-color 200ms linear;
}

/* ---- Direction Arrow Appear ---- */
.direction-arrow {
    transition: opacity var(--anim-arrow-appear) cubic-bezier(0.33, 1, 0.68, 1);
}

.direction-arrow.visible {
    display: DisplayStyle.Flex;
}
